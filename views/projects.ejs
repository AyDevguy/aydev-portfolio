<!-- ==========================================================
     PAGE HEADER
     ========================================================== -->
<section class="archive-hero">
  <div class="wrap">
    <a href="/" class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
      Back to home
    </a>
    <h1 class="line-reveal">Every project, <em>shipped and live.</em></h1>
    <p class="archive-sub line-reveal-text">
      Not a curated highlight reel — <strong>this is the whole list.</strong>
      Filter by what it was built with, or scroll the lot. Each one shipped
      to a real client, not a portfolio-only concept.
    </p>
    <div class="archive-stats">
      <span><b id="statCount"><%= projects.length %></b> projects</span>
      <span class="sep"></span>
      <span>Updated as new work ships</span>
    </div>

    <% /* ---- category display helper ----
       Raw category values sometimes come through as the literal tool or
       library used to build the site ("webflow", "gsap", "js") rather
       than an actual project category, and can occasionally duplicate
       across differently-cased slugs. Normalize known tech names to a
       proper category label, Title-Case anything unrecognized, and
       de-duplicate the filter chips by their normalized label so the
       same category never appears twice. */
    function categoryLabel(raw){
      if (!raw) return '';
      var key = String(raw).trim().toLowerCase();
      var map = {
        webflow: 'Website Build', wordpress: 'Website Build', squarespace: 'Website Build',
        gsap: 'Motion & Interaction', js: 'Custom Development', javascript: 'Custom Development',
        react: 'Web Application', nextjs: 'Web Application', vue: 'Web Application',
        api: 'Integration', shopify: 'E-commerce', figma: 'Design'
      };
      if (map[key]) return map[key];
      return key.replace(/[-_]+/g, ' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); });
    }
    var seenChipLabels = {};
    var dedupedFilterCats = [];
    (filterCats || []).forEach(function(f){
      var norm = categoryLabel(f.label).toLowerCase();
      if (!norm) return;
      if (seenChipLabels[norm] !== undefined){
        dedupedFilterCats[seenChipLabels[norm]].count += (f.count || 0);
      } else {
        seenChipLabels[norm] = dedupedFilterCats.length;
        dedupedFilterCats.push({ label: f.label, count: f.count || 0 });
      }
    });
    %>
    <% function slugifyCat(label){
      return String(label || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    } %>
    <!-- Auto-generated from each project's filterCat — see routes/site.js. -->
    <div class="filter-row" id="filterRow" role="group" aria-label="Filter projects by category">
      <button class="filter-chip active" data-filter="all">All <span class="count"><%= String(projects.length).padStart(2,'0') %></span></button>
      <% dedupedFilterCats.forEach(function(f) { %>
      <button class="filter-chip" data-filter="<%= slugifyCat(categoryLabel(f.label)) %>"><%= categoryLabel(f.label) %> <span class="count"><%= String(f.count).padStart(2,'0') %></span></button>
      <% }); %>
    </div>
  </div>
</section>

<!-- ==========================================================
     PROJECT GRID — rendered server-side from data/projects.json.
     ========================================================== -->
<section class="archive">
  <div class="wrap">
    <div class="project-grid" id="projectGrid">
      <% projects.forEach(function(p, i) { %>
      <article class="project-card" data-cat="<%= slugifyCat(categoryLabel(p.category) || 'website-build') %>" data-observe>
        <a class="card-plate" href="/work/<%= p.slug %>"
          <% if (!p.coverImage) { %>style="--c1:<%= p.color1 %>; --c2:<%= p.color2 %>"<% } %>
          aria-label="View the <%= p.title || 'project' %> case study">
          <% if (p.coverImage) { %>
          <img class="plate-img" src="<%= p.coverImage %>" alt="<%= p.title %> preview" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
          <% } %>
          <span class="plate-index"><%= String(i+1).padStart(2,'0') %> / <%= String(projects.length).padStart(2,'0') %></span>
          <span class="plate-status"><span class="pulse"></span><%= p.status || 'Live' %></span>
          <span class="plate-mark"><%= monogramFor(p) %></span>
        </a>
        <div class="card-body">
          <span class="card-cat"><%= categoryLabel(p.category) || 'Website Build' %></span>
          <h3 class="card-title"><a href="/work/<%= p.slug %>"><%= p.title || 'Untitled Project' %></a></h3>
          <p class="card-desc"><%= p.summary || 'Lorem ipsum dolor sit amet, consectetur adipiscing elit — case study summary coming soon.' %></p>
          <% if (p.tags && p.tags.length) { %>
          <div class="card-tags">
            <% p.tags.forEach(function(t) { %><span class="tag"><%= t %></span><% }); %>
          </div>
          <% } %>
          <a class="card-link" href="/#contact">Discuss a project like this
            <svg viewBox="0 0 24 24" fill="none"><path d="M6 18L18 6M18 6H9M18 6V15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </article>
      <% }); %>
    </div>

    <p class="archive-empty" id="archiveEmpty">Nothing filed under that category yet — check back soon.</p>
  </div>
</section>

