        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button class="ctrl" id="nextBtn" aria-label="Next project" title="Press N">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
    <div class="ctrl-group" role="group" aria-label="Change layout">
      <button class="ctrl view-btn" data-view="stage" aria-label="Stage view" title="Press S">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="7" y="4" width="10" height="16" rx="1"/><rect x="2" y="7" width="4" height="10" rx="1" opacity=".45"/><rect x="18" y="7" width="4" height="10" rx="1" opacity=".45"/></svg>
        <span class="kbd-hint">S</span>
      </button>
      <button class="ctrl view-btn" data-view="grid2" aria-label="Two row grid" title="Press D">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="7" height="7"/><rect x="14" y="4" width="7" height="7"/><rect x="3" y="13" width="7" height="7"/><rect x="14" y="13" width="7" height="7"/></svg>
        <span class="kbd-hint">D</span>
      </button>
      <button class="ctrl view-btn" data-view="grid3" aria-label="List view" title="Press T">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="18" height="4" rx="1"/></svg>
        <span class="kbd-hint">T</span>
      </button>
    </div>
  </div>

