  <!-- Rendered server-side from data/projects.json on every request —
       see routes/site.js and utils/projectsStore.js. Capped to the 4
       most recent projects — the full archive lives at /projects. -->
  <% var shown = Math.min(projects.length, 4); %>
  <div id="workData" hidden>
    <% projects.slice(0, shown).forEach(function(p) { %>
