<!-- Moved down from <head>: these were render-blocking the very first
     paint (browser had to fetch+parse both before it could show any
     HTML/CSS). Loading them here, right before the code that uses them,
     lets the page paint immediately and picks up the couple hundred ms
     of perceived "slow load". -->
<script src="https://cdn.jsdelivr.net/npm/lenis@1.3.25/dist/lenis.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<script>
(function(){
  /* ---- smooth scroll: runs on native scroll, so every existing
     window scroll listener below keeps working untouched ---- */
  if (window.Lenis && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    window.__lenis = new window.Lenis({
      lerp: 0.11,
      duration: 1.1,
      easing: (t) => 1 - Math.pow(1 - t, 4),
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 1.2,
      autoRaf: true,
      anchors: true
    });
  } else if (!window.Lenis){
    console.warn('Lenis failed to load from CDN — smooth scroll is disabled, native scroll still works.');
  }

  const root = document.documentElement;
  const nav = document.getElementById('siteNav');
  const lightBtn = document.getElementById('lightBtn');
  const darkBtn = document.getElementById('darkBtn');
  const menuBtn = document.getElementById('menuBtn');
  const menuLabel = document.getElementById('menuLabel');
  const menuOverlay = document.getElementById('menuOverlay');
  const menuTilesEl = document.getElementById('menuTiles');
  const menuSimpleBg = document.getElementById('menuSimpleBg');
  const bar1 = document.querySelector('.bar1');
  const bar2 = document.querySelector('.bar2');
  const bar3 = document.querySelector('.bar3');

  /* ---- theme switch — light is default, icon colour alone carries state ---- */
  function setTheme(mode){
    root.setAttribute('data-theme', mode);
    const isDark = mode === 'dark';
    darkBtn.classList.toggle('active', isDark);
    lightBtn.classList.toggle('active', !isDark);
    darkBtn.setAttribute('aria-pressed', String(isDark));
    lightBtn.setAttribute('aria-pressed', String(!isDark));
  }
  lightBtn.addEventListener('click', () => setTheme('light'));
  darkBtn.addEventListener('click', () => setTheme('dark'));

  /* ---- build the tile grid used for the desktop mosaic reveal ---- */
  const TILE_COLS = 10, TILE_ROWS = 6;
  const tiles = [];
  for (let t = 0; t < TILE_COLS * TILE_ROWS; t++){
    const el = document.createElement('div');
    el.className = 'menu-tile';
    menuTilesEl.appendChild(el);
    tiles.push(el);
  }
  const isDesktop = () => window.matchMedia('(min-width: 901px)').matches;

  /* ---- hamburger -> X, overlay opens/closes: tile mosaic on desktop
     (smooth center-out ripple), plain fade on mobile/tablet ---- */
  let open = false;
  let menuAnimating = false;
  function toggleMenu(){
    if (menuAnimating) return;
    open = !open;
    menuAnimating = true;
    menuBtn.classList.toggle('is-open', open);
    nav.classList.toggle('nav--inverted', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuLabel.textContent = open ? 'CLOSE' : 'MENU';
    const desktop = isDesktop();

    if (open){
      menuOverlay.classList.add('is-open');
      menuOverlay.style.pointerEvents = 'auto';
      const tl = gsap.timeline({ onComplete: () => { menuAnimating = false; } });
      if (desktop){
        tl.to(tiles, {
          scale: 1.03, opacity: 1, duration: 0.7, ease: 'power2.out',
          stagger: { each: 0.014, grid: [TILE_ROWS, TILE_COLS], from: 'center' }
        }, 0);
      } else {
        tl.to(menuSimpleBg, { opacity: 1, duration: 0.4, ease: 'power2.out' }, 0);
      }
      tl.fromTo('.menu-overlay a', { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: 'power3.out', stagger: 0.05 }, desktop ? 0.22 : 0.1);
      tl.to(bar1, { rotate: 45, y: 7, duration: .35, ease: 'back.out(1.7)' }, 0);
      tl.to(bar3, { rotate: -45, y: -7, duration: .35, ease: 'back.out(1.7)' }, 0);
      tl.to(bar2, { opacity: 0, duration: .2 }, 0);
      const firstLink = menuOverlay.querySelector('a');
      if (firstLink) firstLink.focus({ preventScroll:true });
    } else {
      const tl = gsap.timeline({
        onComplete: () => { menuOverlay.classList.remove('is-open'); menuOverlay.style.pointerEvents = 'none'; menuAnimating = false; }
      });
      tl.to('.menu-overlay a', { y: 16, opacity: 0, duration: 0.2, ease: 'power2.in', stagger: 0.02 }, 0);
      if (desktop){
        tl.to(tiles, {
          scale: 0.5, opacity: 0, duration: 0.55, ease: 'power2.in',
          stagger: { each: 0.01, grid: [TILE_ROWS, TILE_COLS], from: 'edges' }
        }, 0.1);
      } else {
        tl.to(menuSimpleBg, { opacity: 0, duration: 0.3, ease: 'power2.in' }, 0.08);
      }
      tl.to(bar1, { rotate: 0, y: 0, duration: .35, ease: 'power3.inOut' }, 0);
      tl.to(bar3, { rotate: 0, y: 0, duration: .35, ease: 'power3.inOut' }, 0);
      tl.to(bar2, { opacity: 1, duration: .3 }, 0.08);
      menuBtn.focus({ preventScroll:true });
    }
  }
  menuBtn.addEventListener('click', toggleMenu);
  document.querySelectorAll('.menu-overlay a').forEach(link => {
    link.addEventListener('click', () => { if (open) toggleMenu(); });
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && open) toggleMenu();
  });
  gsap.set([bar1,bar2,bar3], { transformOrigin:'50% 50%' });

  /* ---- nav: transparent at top, fills in once scrolled, collapses on scroll-down ---- */
  let lastY = window.scrollY;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    nav.classList.toggle('nav--scrolled', y > 20);
    if (y > lastY && y > 80){ nav.classList.add('nav--collapsed'); }
    else if (y < lastY){ nav.classList.remove('nav--collapsed'); }
    lastY = y;
  }, { passive:true });

  /* ---- hero parallax: panel and copy drift at slightly different rates
     as the hero scrolls past, for a sense of depth. Capped so it only
     runs while the hero is actually on screen, and reduced-motion safe. ---- */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    const heroEl = document.querySelector('.hero');
    const heroPanel = document.getElementById('panel');
    const heroCopy = document.querySelector('.hero-copy');
    if (heroEl && heroPanel){
      let parallaxQueued = false;
      function updateHeroParallax(){
        parallaxQueued = false;
        const rect = heroEl.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > window.innerHeight) return;
        const progress = Math.min(1, Math.max(0, -rect.top / Math.max(rect.height, 1)));
        heroPanel.style.transform = `translateY(${progress * -46}px)`;
        if (heroCopy) heroCopy.style.transform = `translateY(${progress * -20}px)`;
      }
      window.addEventListener('scroll', () => {
        if (!parallaxQueued){ parallaxQueued = true; requestAnimationFrame(updateHeroParallax); }
      }, { passive:true });
      updateHeroParallax();
    }
  }


  gsap.from('.eyebrow', { y:12, opacity:0, duration:.6, ease:'power3.out', delay:.1 });
  gsap.from('h1', { y:22, opacity:0, duration:.75, ease:'power3.out', delay:.18 });
  gsap.from('.subhead', { y:16, opacity:0, duration:.65, ease:'power3.out', delay:.3 });
  gsap.from('.cta-row', { y:14, opacity:0, duration:.6, ease:'power3.out', delay:.4 });
  gsap.from('#panel', { y:24, opacity:0, duration:.8, ease:'power3.out', delay:.28 });
  /* testimonial marquee: JS-driven with exact pixel measurement instead of a
     CSS percentage-based animation, so the loop point can never sub-pixel
     mismatch and glitch at the seam */
  (function(){
    const mask = document.querySelector('.testi-mask');
    const track = document.querySelector('.testi-track');
    if (!mask || !track) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // The track ships with 2 copies of the testimonial set (needed for the
    // seamless-loop trick), but 2 copies only actually cover screens
    // narrower than one set's width. On anything wider — most desktops —
    // the visible mask window is wider than a single set, so the track
    // runs out of cards mid-scroll, well before the loop point, and the
    // marquee visibly gaps/jumps instead of looping forever. Fix: measure
    // one set's true width, then clone as many extra copies as needed to
    // always keep a full mask-width of buffer ahead of the wrap — genuinely
    // infinite at any viewport size.
    const baseCards = Array.prototype.slice.call(track.children, 0, track.children.length / 2);
    let setWidth = 0;

    function rebuild(){
      if (!baseCards.length) return;
      track.innerHTML = '';
      function addSet(decorative){
        baseCards.forEach(function(c){
          const clone = c.cloneNode(true);
          if (decorative) clone.setAttribute('aria-hidden', 'true');
          track.appendChild(clone);
        });
      }
      addSet(false);
      addSet(true);
      const firstOfSet2 = track.children[baseCards.length];
      setWidth = firstOfSet2.getBoundingClientRect().left - track.children[0].getBoundingClientRect().left;
      if (setWidth <= 0) return;
      const maskWidth = mask.getBoundingClientRect().width;
      const copiesNeeded = Math.max(2, Math.ceil((maskWidth + setWidth) / setWidth) + 1);
      for (let i = 2; i < copiesNeeded; i++) addSet(true);
    }

    rebuild();
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(rebuild, 150);
    });
    if (document.fonts && document.fonts.ready){
      document.fonts.ready.then(rebuild);
    }

    let paused = false;
    mask.addEventListener('mouseenter', () => { paused = true; });
    mask.addEventListener('mouseleave', () => { paused = false; });

    const SPEED = 36; // px per second
    let x = 0;
    let last = null;
    function loop(now){
      requestAnimationFrame(loop);
      if (last === null) last = now;
      const dt = (now - last) / 1000;
      last = now;
      if (!paused && setWidth > 0){
        x -= SPEED * dt;
        if (x <= -setWidth) x += setWidth;
        track.style.transform = `translate3d(${x}px,0,0)`;
      }
    }
    requestAnimationFrame(loop);
  })();

  /* activity log: each line's state is driven by one attribute —
     data-status="deployed" or data-status="building" — change that
     to flip what a project shows, nothing else needs editing. */
  document.querySelectorAll('#log .log-line').forEach(function(line){
    var status = line.dataset.status === 'building' ? 'building' : 'deployed';
    var cursor = status === 'building' ? '<span class="cursor"></span>' : '';
    line.innerHTML =
      '<span class="log-status ' + status + '">' + status + '</span>' +
      '<span class="log-proj">' + line.dataset.proj + '</span>' +
      '<span class="log-note">' + line.dataset.note + cursor + '</span>';
  });

  /* scramble effect on hover — a techy decrypt-in for the project name */
  (function(){
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var SCRAMBLE_CHARS = '!<>-_\\/[]{}—=+*^?#01';

    function scramble(el, text){
      var frame = 0;
      var resolved = new Array(text.length).fill(false);
      var revealEvery = 2; // reveal roughly one more real character every N frames
      cancelAnimationFrame(el._scrambleRaf);
      function tick(){
        var out = '';
        var doneCount = 0;
        for (var i = 0; i < text.length; i++){
          if (resolved[i]){ out += text[i]; doneCount++; continue; }
          if (text[i] === ' ' || text[i] === '-'){ out += text[i]; resolved[i] = true; doneCount++; continue; }
          if (frame > i * revealEvery + 6){
            resolved[i] = true;
            out += text[i];
            doneCount++;
          } else {
            out += SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
          }
        }
        el.textContent = out;
        frame++;
        if (doneCount < text.length){
          el._scrambleRaf = requestAnimationFrame(tick);
        }
      }
      tick();
    }

    document.querySelectorAll('#log .log-line').forEach(function(line){
      var projEl = line.querySelector('.log-proj');
      if (!projEl) return;
      var original = projEl.textContent;
      line.addEventListener('mouseenter', function(){ scramble(projEl, original); });
    });
  })();

  gsap.to('.log-line', { opacity:1, duration:.5, ease:'power2.out', stagger:.18, delay:.9 });
  gsap.from('.scroll-cue', { opacity:0, duration:.8, delay:1.1 });

  /* letter-by-letter scan on the scroll cue, looping forever */
  (function(){
    const el = document.getElementById('scrollText');
    const text = el.textContent;
    el.textContent = '';
    const letters = [];
    for (const ch of text){
      const span = document.createElement('span');
      span.className = 'scroll-letter';
      span.textContent = ch === ' ' ? '\u00A0' : ch;
      el.appendChild(span);
      letters.push(span);
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
      let i = 0;
      setInterval(() => {
        letters.forEach(l => l.classList.remove('lit'));
        letters[i].classList.add('lit');
        i = (i + 1) % letters.length;
      }, 170);
    }
  })();


  /* ---- work section: full carousel port (tabs, infinite stage, grid views,
     keyboard nav, resize resync) — behaviour identical to the reference,
     re-themed onto the hero's tokens. No Lottie: no animation asset exists
     in this build, so that optional decorative hook is simply omitted. ---- */
  (function(){
    const workSection = document.getElementById('work');
    if (!workSection) return;

    const projects = [...workSection.querySelectorAll('#workData .work-item')].map(el => ({
      title: el.dataset.title,
      cat:   el.dataset.category,
      c1:    el.dataset['color-1'],
      c2:    el.dataset['color-2'],
      img:   el.dataset.image || '',
      url:   el.dataset.url || ''
    }));

    /* cards get a uniform background color; a project with an image gets
       a real <img> element layered on top instead of a CSS background */
    function plateStyle(){
      return `background:var(--surface);`;
    }
    function plateInner(p){
      return p.img ? `<img class="plate-img" src="${p.img}" alt="${p.title} preview" loading="lazy">` : '';
    }
    /* tab thumbnails need an actual CSS background-image value (used
       via inline style, not an <img> element) — cover image if there
       is one, otherwise the same color1/color2 gradient the plate
       falls back to. This function was called by buildTabs() below
       but missing from the original file; added here. */
    function plateBg(p){
      return p.img ? `url('${p.img}')` : `linear-gradient(135deg, ${p.c1}, ${p.c2})`;
    }

    const len = projects.length;
    let current = 0;
    let view = "stage"; // stage | grid2 | grid3

    const stageEl    = document.getElementById("stage");
    const gridEl     = document.getElementById("grid");
    const tabsEl     = document.getElementById("tabs");
    const timecodeEl = document.getElementById("timecode");
    const navGroup   = document.getElementById("navGroup");
    const viewBtns   = workSection.querySelectorAll("[data-view]");

    function pad(n){ return String(n).padStart(2,"0"); }

    /* ---------- build tabs ---------- */
    function buildTabs(){
      tabsEl.innerHTML = "";
      projects.forEach((p, i) => {
        const tab = document.createElement("button");
        tab.className = "tab" + (i === current ? " active" : "");
        tab.setAttribute("role","tab");
        tab.setAttribute("aria-selected", i === current ? "true" : "false");
        tab.setAttribute("aria-label", p.title);
        tab.setAttribute("title", p.title + " — press " + (i+1));
        tab.innerHTML = `<span class="tab-thumb" style="background-image:${plateBg(p)};background-size:cover;background-position:center;"></span><span class="tab-idx">${pad(i+1)}</span>`;
        tab.addEventListener("click", () => selectProject(i));
        tabsEl.appendChild(tab);
      });
    }

    function updateTabs(){
      [...tabsEl.children].forEach((t,i) => {
        t.classList.toggle("active", i === current);
        t.setAttribute("aria-selected", i === current ? "true":"false");
      });
    }

    /* ---------- infinite stage: a repeating strip of clones on one
       GSAP-driven track. State is deterministic — 'current'/'activeSlot'
       are only ever set directly by our own navigation functions. ---------- */
    const CYCLES = 3;
    let slides = [];
    let trackEl = null;
    let activeSlot = len;
    let animating = false;

    function buildStage(){
      stageEl.innerHTML = "";
      trackEl = document.createElement("div");
      trackEl.className = "stage-track";
      stageEl.appendChild(trackEl);
      slides = [];

      for (let c = 0; c < CYCLES; c++){
        projects.forEach((p, i) => {
          const slot = c * len + i;
          const slide = document.createElement("div");
          slide.className = "slide" + (p.img ? " has-image" : "");
          slide.dataset.slot = slot;
          slide.innerHTML = `
            <div class="slide-plate" style="${plateStyle(p)}">${plateInner(p)}</div>
            <div class="slide-caption">
              <span class="cap-index">${pad(i+1)}</span>
              <div class="cap-body">
                <span class="cap-cat">${p.cat}</span>
                <div class="cap-title">${p.title}</div>
              </div>
            </div>`;
          slide.addEventListener("click", () => {
            if (p.url) window.location.href = p.url;
          });
          trackEl.appendChild(slide);
          slides[slot] = slide;
        });
      }

      gsap.set(trackEl, { x: 0 });
      gsap.set(trackEl, { x: xForSlot(activeSlot) });
      applyVisualStates(false);
    }

    function unit(){
      if (slides.length < 2) return 1;
      return slides[1].getBoundingClientRect().left - slides[0].getBoundingClientRect().left;
    }

    function xForSlot(slot){
      const stageRect = stageEl.getBoundingClientRect();
      const slideRect = slides[slot].getBoundingClientRect();
      const currentCenter = slideRect.left + slideRect.width / 2;
      const desiredCenter = stageRect.left + stageRect.width / 2;
      const currentX = gsap.getProperty(trackEl, "x") || 0;
      return currentX + (desiredCenter - currentCenter);
    }

    function applyVisualStates(animate){
      slides.forEach(el => {
        const slot = Number(el.dataset.slot);
        const dist = Math.abs(slot - activeSlot);
        const scale = dist === 0 ? 1 : dist === 1 ? .82 : .68;
        const op    = dist === 0 ? 1 : dist === 1 ? .55 : 0;
        el.style.pointerEvents = op > 0 ? "auto" : "none";
        el.classList.toggle("is-current", dist === 0);
        const vars = { scale, opacity: op, zIndex: 10 - dist };
        if (animate) gsap.to(el, { ...vars, duration:.6, ease:"expo.out", overwrite:"auto" });
        else gsap.set(el, vars);
      });
    }

    function recenter(){
      const needsFold = activeSlot >= 2 * len || activeSlot < len;
      if (!needsFold) return;
      activeSlot += activeSlot >= 2 * len ? -len : len;
      gsap.killTweensOf(trackEl);
      gsap.killTweensOf(slides);
      gsap.set(trackEl, { x: xForSlot(activeSlot) });
      applyVisualStates(false);
    }

    function goToSlot(slot){
      if (animating) return;
      animating = true;
      activeSlot = slot;
      current = ((slot % len) + len) % len;
      updateTabs();
      timecodeEl.innerHTML = `<b>${pad(current+1)}</b> / ${pad(len)}`;
      gsap.to(trackEl, {
        x: xForSlot(activeSlot),
        duration:.6, ease:"expo.out", overwrite:"auto",
        onComplete: () => { recenter(); animating = false; }
      });
      applyVisualStates(true);
    }

    function next(){ goToSlot(activeSlot + 1); }
    function prev(){ goToSlot(activeSlot - 1); }

    function syncStagePosition(){
      if (!trackEl) return;
      void stageEl.offsetHeight;
      gsap.set(trackEl, { x: xForSlot(activeSlot) });
      applyVisualStates(false);
    }

    let resizeTimer;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { if (view === "stage") syncStagePosition(); }, 120);
    });

    /* ---------- build grid cells ---------- */
    function buildGrid(){
      gridEl.innerHTML = "";
      projects.forEach((p, i) => {
        const cell = document.createElement("div");
        cell.className = "cell" + (p.img ? " has-image" : "");
        cell.innerHTML = `
          <div class="cell-plate" style="${plateStyle(p)}">${plateInner(p)}</div>
          <div class="cell-caption">
            <span class="cell-index">${pad(i+1)}</span>
            <span class="cell-cat">${p.cat}</span>
            <div class="cell-title">${p.title}</div>
          </div>`;
        cell.addEventListener("click", () => { if (p.url) window.location.href = p.url; });
        gridEl.appendChild(cell);
      });
    }

    /* ---------- interaction ---------- */
    function selectProject(i){
      const curMod = ((activeSlot % len) + len) % len;
      let delta = ((i - curMod) + len) % len;
      if (delta > len / 2) delta -= len;
      goToSlot(activeSlot + delta);
    }

    function setView(v){
      if (v === view) return;
      const prevView = view;
      view = v;

      viewBtns.forEach(b => b.classList.toggle("active", b.dataset.view === v));

      const hideChrome = v !== "stage";
      navGroup.dataset.hidden = hideChrome ? "true" : "false";
      tabsEl.dataset.hidden   = hideChrome ? "true" : "false";
      timecodeEl.dataset.hidden = hideChrome ? "true" : "false";

      // Controls that just got hidden (opacity:0, pointer-events:none) can
      // still hold real keyboard focus if that's where the user was when
      // they pressed S/D/T — leaving a focus-visible ring "trapped" on an
      // invisible control and no visible indicator of what's now active.
      // Move focus off them immediately so nothing stale is left behind.
      if (hideChrome && document.activeElement){
        if (navGroup.contains(document.activeElement) || tabsEl.contains(document.activeElement)){
          document.activeElement.blur();
        }
      }

      if (prevView !== "stage" && v !== "stage"){
        gsap.to(gridEl, {
          opacity:0, y:-10, scale:.985, duration:.38, ease:"power2.inOut", overwrite:"auto",
          onComplete:() => {
            gridEl.classList.toggle("rows-2", v === "grid2");
            gridEl.classList.toggle("rows-3", v === "grid3");
            gsap.fromTo(gridEl, {opacity:0, y:10, scale:.985}, {opacity:1, y:0, scale:1, duration:.5, ease:"power2.out"});
          }
        });
        return;
      }

      const showEl = v === "stage" ? stageEl : gridEl;
      const hideEl = v === "stage" ? gridEl  : stageEl;

      if (v !== "stage"){
        gridEl.classList.toggle("rows-2", v === "grid2");
        gridEl.classList.toggle("rows-3", v === "grid3");
      }

      gsap.to(hideEl, {
        opacity:0, y:-10, scale:.97, filter:"blur(8px)",
        duration:.45, ease:"power2.inOut", overwrite:"auto",
        onComplete:() => { hideEl.hidden = true; gsap.set(hideEl, {clearProps:"filter,transform"}); }
      });

      showEl.hidden = false;
      if (v === "stage") syncStagePosition();
      gsap.fromTo(showEl,
        {opacity:0, y:16, scale:.97, filter:"blur(8px)"},
        {opacity:1, y:0, scale:1, filter:"blur(0px)", duration:.85, ease:"power3.out", delay:.28, overwrite:"auto",
         clearProps:"filter,transform"}
      );

      if (v !== "stage"){
        gsap.fromTo([...gridEl.children],
          {opacity:0, y:18, scale:.96, filter:"blur(6px)"},
          {opacity:1, y:0, scale:1, filter:"blur(0px)", duration:.7, ease:"power3.out", stagger:.06, delay:.34, clearProps:"filter,transform"});
      }
    }

    viewBtns.forEach(b => b.addEventListener("click", () => setView(b.dataset.view)));
    document.getElementById("nextBtn").addEventListener("click", next);
    document.getElementById("prevBtn").addEventListener("click", prev);

    // Keyboard shortcuts (S/D/T/1-9) change `view` via setView() without a
    // click ever happening, so the browser never moves focus on its own —
    // without this, the focus-visible outline stays stuck on whichever
    // button was last clicked, looking like a stray highlight on the view
    // you just switched away from. This moves it to match reality.
    function focusViewBtn(v){
      const btn = workSection.querySelector('.view-btn[data-view="' + v + '"]');
      if (btn) btn.focus({ preventScroll: true });
    }

    document.addEventListener("keydown", e => {
      const tag = (document.activeElement && document.activeElement.tagName) || "";
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      if (view === "stage"){
        if (e.key === "ArrowRight") next();
        if (e.key === "ArrowLeft") prev();
      }

      const key = e.key.toLowerCase();
      if (view === "stage" && key === "p") prev();
      else if (view === "stage" && key === "n") next();
      else if (key === "s") { setView("stage"); focusViewBtn("stage"); }
      else if (key === "d") { setView("grid2"); focusViewBtn("grid2"); }
      else if (key === "t") { setView("grid3"); focusViewBtn("grid3"); }
      else if (/^[1-9]$/.test(e.key)){
        const i = parseInt(e.key, 10) - 1;
        if (i < len){ setView("stage"); focusViewBtn("stage"); selectProject(i); }
      }
    });

    buildTabs();
    buildStage();
    buildGrid();
    timecodeEl.innerHTML = `<b>${pad(current+1)}</b> / ${pad(len)}`;
    viewBtns.forEach(b => b.classList.toggle("active", b.dataset.view === "stage"));
  })();



  (function(){
    const canvas = document.getElementById('bgCanvas');
    const ctx = canvas.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize(){
      const dpr = Math.min(window.devicePixelRatio, 2);
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    function computeCellSize(){
      const w = window.innerWidth;
      if (w < 480) return 44;
      if (w < 780) return 56;
      if (w < 1100) return 72;
      return 92;
    }
    let CELL = computeCellSize();

    let resizeQueued = false;
    window.addEventListener('resize', () => {
      if (resizeQueued) return;
      resizeQueued = true;
      requestAnimationFrame(() => { resize(); CELL = computeCellSize(); resizeQueued = false; });
    }, { passive:true });

    function readColors(){
      const cs = getComputedStyle(root);
      const accentHex = cs.getPropertyValue('--accent').trim();
      return {
        line: cs.getPropertyValue('--grid-line').trim(),
        accentRGB: hexToRgb(accentHex)
      };
    }
    function hexToRgb(hex){
      hex = hex.replace('#','');
      if (hex.length === 3) hex = hex.split('').map(c => c+c).join('');
      const n = parseInt(hex, 16);
      return { r:(n>>16)&255, g:(n>>8)&255, b:n&255 };
    }
    let colors = readColors();
    const themeObserver = new MutationObserver(() => { colors = readColors(); });
    themeObserver.observe(root, { attributes:true, attributeFilter:['data-theme'] });

    /* trail: a short history of recently visited cells, each fading independently */
    let trail = [];
    let lastKey = null;
    const LIFETIME = 650;

    /* cursor-reactive bend: grid lines (and the trail fill) warp outward near the pointer.
       The mousemove handler only records raw coordinates — all math happens once per
       animation frame, and the bend follows a lerped (eased) cursor position so it
       glides rather than snaps. */
    let rawX = -9999, rawY = -9999;
    let mouseX = -9999, mouseY = -9999;
    let hasPointer = false;
    let lastMoveTime = 0;
    let bendStrength = 0;
    const BEND_IDLE_MS = 1300;
    const BEND_RADIUS = 240, BEND_AMP = 46;
    const BEND_R2 = BEND_RADIUS * BEND_RADIUS;
    const bentPt = { x:0, y:0 };

    function bend(x, y){
      if (bendStrength < 0.001){ bentPt.x = x; bentPt.y = y; return bentPt; }
      const dx = x - mouseX, dy = y - mouseY;
      const d2 = dx*dx + dy*dy;
      if (d2 > BEND_R2 || d2 < 0.0001){ bentPt.x = x; bentPt.y = y; return bentPt; }
      const dist = Math.sqrt(d2);
      const f = 1 - dist / BEND_RADIUS;
      const push = BEND_AMP * f * f * bendStrength;
      bentPt.x = x + (dx / dist) * push;
      bentPt.y = y + (dy / dist) * push;
      return bentPt;
    }

    function bentLine(x1, y1, x2, y2){
      const len = Math.hypot(x2 - x1, y2 - y1);
      const steps = Math.max(2, Math.round(len / 22));
      let p = bend(x1, y1);
      ctx.moveTo(p.x, p.y);
      for (let s = 1; s <= steps; s++){
        const t = s / steps;
        p = bend(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t);
        ctx.lineTo(p.x, p.y);
      }
    }

    function bentCellPath(cx, cy, size){
      ctx.beginPath();
      let p = bend(cx, cy);
      ctx.moveTo(p.x, p.y);
      p = bend(cx + size, cy);       ctx.lineTo(p.x, p.y);
      p = bend(cx + size, cy + size); ctx.lineTo(p.x, p.y);
      p = bend(cx, cy + size);        ctx.lineTo(p.x, p.y);
      ctx.closePath();
    }

    if (!reduceMotion){
      window.addEventListener('mousemove', (e) => {
        rawX = e.clientX; rawY = e.clientY;
        hasPointer = true;
        lastMoveTime = performance.now();
      }, { passive:true });
    }

    function draw(){
      requestAnimationFrame(draw);
      const w = window.innerWidth, h = window.innerHeight;
      ctx.clearRect(0, 0, w, h);

      if (hasPointer){
        mouseX += (rawX - mouseX) * 0.18;
        mouseY += (rawY - mouseY) * 0.18;

        const idle = performance.now() - lastMoveTime;
        const targetStrength = idle < BEND_IDLE_MS ? 1 : 0;
        bendStrength += (targetStrength - bendStrength) * 0.06;

        const ci = Math.floor(rawX / CELL);
        const cj = Math.floor(rawY / CELL);
        const key = ci + ',' + cj;
        if (key !== lastKey){
          lastKey = key;
          trail.push({ ci, cj, t: performance.now() });
          if (trail.length > 40) trail.shift();
        }
      }

      const now = performance.now();
      if (trail.length) trail = trail.filter(cell => now - cell.t < LIFETIME);

      if (trail.length){
        const { r, g, b } = colors.accentRGB;
        for (let i = 0; i < trail.length; i++){
          const cell = trail[i];
          const age = (now - cell.t) / LIFETIME;
          const eased = 1 - (1 - age) * (1 - age);
          ctx.fillStyle = `rgba(${r},${g},${b},${(1 - eased) * 0.1})`;
          bentCellPath(cell.ci * CELL, cell.cj * CELL, CELL);
          ctx.fill();
        }
      }

      ctx.strokeStyle = colors.line;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let x = 0; x <= w; x += CELL){
        bentLine(x + 0.5, 0, x + 0.5, h);
      }
      for (let y = 0; y <= h; y += CELL){
        bentLine(0, y + 0.5, w, y + 0.5);
      }
      ctx.stroke();
    }
    draw();
  })();
})();
</script>

<div class="view-cursor" id="viewCursor" aria-hidden="true">View project</div>

<script>
(function(){
  /* ---- scroll-reveal: triggers heading swipes and fade-ins that were never wired up ---- */
  /* ---- line-sweep reveal utility: wraps text into words, groups them
     into their actual rendered lines, and returns a play() function that
     drives a solid bar sweeping 0%->100% over each line (covering it),
     then peeling back 100%->0% to uncover the real text — staggered
     line by line. Used for the hero h1 and every section h2. ---- */
  function prepLineReveal(el){
    function wrapWords(node){
      if (node.nodeType === 3){
        var frag = document.createDocumentFragment();
        var parts = node.textContent.split(/(\s+)/);
        parts.forEach(function(p){
          if (p === '') return;
          if (/^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); }
          else {
            var span = document.createElement('span');
            span.className = 'word';
            span.textContent = p;
            frag.appendChild(span);
          }
        });
        node.parentNode.replaceChild(frag, node);
      } else if (node.nodeType === 1){
        Array.prototype.slice.call(node.childNodes).forEach(wrapWords);
      }
    }
    Array.prototype.slice.call(el.childNodes).forEach(wrapWords);

    var words = Array.prototype.slice.call(el.querySelectorAll('.word'));
    if (!words.length) return null;

    var lineGroups = [];
    var lastTop = null;
    words.forEach(function(w){
      var top = Math.round(w.offsetTop);
      if (lastTop === null || Math.abs(top - lastTop) > 4){
        lineGroups.push([w]);
        lastTop = top;
      } else {
        lineGroups[lineGroups.length - 1].push(w);
      }
    });

    var elRect = el.getBoundingClientRect();
    var lines = lineGroups.map(function(group){
      var first = group[0], last = group[group.length - 1];
      var firstRect = first.getBoundingClientRect();
      var lastRect = last.getBoundingClientRect();
      var bar = document.createElement('span');
      bar.className = 'line-sweep';
      bar.style.top = (firstRect.top - elRect.top) + 'px';
      bar.style.left = (firstRect.left - elRect.left) + 'px';
      bar.style.width = (lastRect.right - firstRect.left) + 'px';
      bar.style.height = firstRect.height + 'px';
      el.appendChild(bar);
      return { bar: bar, words: group };
    });

    var played = false;
    return function play(){
      if (played) return;
      played = true;
      var master = gsap.timeline();
      lines.forEach(function(line, i){
        var lineTl = gsap.timeline();
        lineTl.set(line.bar, { transformOrigin: 'left center' })
          .to(line.bar, { scaleX: 1, duration: .45, ease: 'power3.inOut' })
          .set(line.words, { opacity: 1 })
          .set(line.bar, { transformOrigin: 'right center' })
          .to(line.bar, { scaleX: 0, duration: .5, ease: 'power3.inOut' }, '+=0.04');
        master.add(lineTl, i * 0.16);
      });
      return master;
    };
  }

  /* ---- subhead reveal: lighter, more restrained scroll animation for
     descriptions and sub-headings — no bar sweep, just a clean staggered
     fade, rise, and unblur. Reserving the bar-sweep for h1/h2 only. ---- */
  function prepSubheadReveal(el){
    function wrapWords(node){
      if (node.nodeType === 3){
        var frag = document.createDocumentFragment();
        var parts = node.textContent.split(/(\s+)/);
        parts.forEach(function(p){
          if (p === '') return;
          if (/^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); }
          else {
            var span = document.createElement('span');
            span.className = 'word';
            span.textContent = p;
            frag.appendChild(span);
          }
        });
        node.parentNode.replaceChild(frag, node);
      } else if (node.nodeType === 1){
        Array.prototype.slice.call(node.childNodes).forEach(wrapWords);
      }
    }
    Array.prototype.slice.call(el.childNodes).forEach(wrapWords);
    var words = Array.prototype.slice.call(el.querySelectorAll('.word'));
    if (!words.length) return null;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) gsap.set(words, { opacity: 0, y: 10, filter: 'blur(6px)' });

    var played = false;
    return function play(){
      if (played) return;
      played = true;
      return gsap.to(words, {
        opacity: 1, y: 0, filter: 'blur(0px)',
        duration: .8, stagger: 0.016, ease: 'power2.out'
      });
    };
  }

  function setupLineReveals(){
    document.querySelectorAll('.line-reveal').forEach(function(el){
      el.__playLineReveal = prepLineReveal(el);
    });
    document.querySelectorAll('.line-reveal-text').forEach(function(el){
      el.__playLineReveal = prepSubheadReveal(el);
    });
    var heroH1 = document.querySelector('h1.line-reveal');
    if (heroH1 && heroH1.__playLineReveal) heroH1.__playLineReveal();
    var heroSub = document.querySelector('.hero-copy .line-reveal-text');
    if (heroSub && heroSub.__playLineReveal) heroSub.__playLineReveal();
  }
  if (document.fonts && document.fonts.ready){
    document.fonts.ready.then(function(){ requestAnimationFrame(setupLineReveals); });
  } else {
    setTimeout(setupLineReveals, 200);
  }

  /* trust-panel stat numbers count up from 0 the moment they scroll into
     view, instead of just appearing — same trigger as the meter-bar fill
     below them, so both read as one animation. Handles "14", "100%", and
     "<48h" alike by isolating the numeric run and keeping whatever sits
     on either side of it. */
  function animateCountUp(cellEl){
    var numEl = cellEl.querySelector('.cell-num');
    if (!numEl || numEl.__counted) return;
    numEl.__counted = true;
    var match = numEl.textContent.trim().match(/^(\D*)(\d+)(\D*)$/);
    if (!match) return;
    var prefix = match[1], target = parseInt(match[2], 10), suffix = match[3];
    var proxy = { val: 0 };
    gsap.to(proxy, {
      val: target, duration: 1.3, delay: .15, ease: 'power2.out',
      onUpdate: function(){ numEl.textContent = prefix + Math.round(proxy.val) + suffix; }
    });
  }

  var revealTargets = document.querySelectorAll('h2.line-reveal, .work-heading h1.line-reveal, .line-reveal-text, [data-observe]');
  function reveal(el){
    if (el.classList.contains('line-reveal') || el.classList.contains('line-reveal-text')){
      (function tryPlay(){
        if (el.__playLineReveal){ el.__playLineReveal(); }
        else { requestAnimationFrame(tryPlay); }
      })();
      return;
    }
    el.classList.add('in-view');
    if (el.classList.contains('trust-cell')) animateCountUp(el);
  }
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries, obs){
      entries.forEach(function(entry){
        if (entry.isIntersecting){
          reveal(entry.target);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.35 });
    revealTargets.forEach(function(el){ io.observe(el); });
  } else {
    revealTargets.forEach(reveal);
  }

  /* ---- process timeline: vertical progress line that follows scroll
     continuously, precisely anchored between the first and last badge so
     it always reaches exactly the last stage — never short, never long ---- */
  var timelineEl = document.getElementById('timeline');
  var progressEl = document.getElementById('timelineProgress');
  var trackEl = document.getElementById('timelineTrack');
  var stepEls = document.querySelectorAll('.step');
  var allBadges = document.querySelectorAll('.step-badge');
  var journeyQueued = false;

  function updateTimelineProgress(){
    journeyQueued = false;
    if (!timelineEl || !progressEl || !allBadges.length) return;
    var tRect = timelineEl.getBoundingClientRect();
    var firstRect = allBadges[0].getBoundingClientRect();
    var lastRect = allBadges[allBadges.length - 1].getBoundingClientRect();
    var startY = firstRect.top + firstRect.height / 2 - tRect.top;
    var endY = lastRect.bottom - tRect.top;
    if (trackEl){
      trackEl.style.top = startY + 'px';
      trackEl.style.height = Math.max(0, endY - startY) + 'px';
    }
    var anchor = window.innerHeight * 0.62;
    var reachY = anchor - tRect.top;
    var pct = (endY - startY) > 0 ? (reachY - startY) / (endY - startY) : 0;
    pct = Math.max(0, Math.min(1, pct));

    var docEl = document.documentElement;
    var atPageBottom = (window.scrollY + window.innerHeight) >= (docEl.scrollHeight - 3);
    if (atPageBottom) pct = 1;

    progressEl.style.top = startY + 'px';
    progressEl.style.height = Math.max(0, (endY - startY) * pct) + 'px';

    stepEls.forEach(function(step){
      var badge = step.querySelector('.step-badge');
      if (!badge) return;
      var bRect = badge.getBoundingClientRect();
      var badgeCenter = bRect.top + bRect.height / 2;
      var wasPassed = step.classList.contains('is-passed');
      var nowPassed = atPageBottom || badgeCenter < anchor;
      if (nowPassed && !wasPassed){
        step.classList.add('is-arriving');
        setTimeout(function(){ step.classList.remove('is-arriving'); }, 650);
      }
      step.classList.toggle('is-passed', nowPassed);
    });
  }
  window.addEventListener('scroll', function(){
    if (!journeyQueued){ journeyQueued = true; requestAnimationFrame(updateTimelineProgress); }
  }, { passive:true });
  window.addEventListener('resize', updateTimelineProgress);
  updateTimelineProgress();

  /* ---- custom "view project" cursor over work cards ---- */
  var cursorEl = document.getElementById('viewCursor');
  var workSectionEl = document.getElementById('work');
  if (cursorEl && workSectionEl && window.matchMedia('(hover:hover)').matches){
    var cx = -100, cy = -100, tx = -100, ty = -100;
    var cursorActive = false;
    var cursorScrollQueued = false;
    window.addEventListener('mousemove', function(e){
      tx = e.clientX; ty = e.clientY;
      var overSlide = e.target.closest && e.target.closest('.work .slide');
      cursorActive = !!overSlide;
      cursorEl.classList.toggle('is-active', cursorActive);
    }, { passive:true });
    window.addEventListener('scroll', function(){
      if (cursorScrollQueued) return;
      cursorScrollQueued = true;
      requestAnimationFrame(function(){
        cursorScrollQueued = false;
        var elAtPoint = document.elementFromPoint(tx, ty);
        var overSlide = elAtPoint && elAtPoint.closest && elAtPoint.closest('.work .slide');
        cursorActive = !!overSlide;
        cursorEl.classList.toggle('is-active', cursorActive);
      });
    }, { passive:true });
    (function loop(){
      requestAnimationFrame(loop);
      cx += (tx - cx) * 0.22;
      cy += (ty - cy) * 0.22;
      cursorEl.style.transform = 'translate(' + cx + 'px,' + cy + 'px) translate(-50%,-50%) scale(' + (cursorActive ? 1 : 0.7) + ')';
    })();
  }
})();
</script>

</body>
</html>
